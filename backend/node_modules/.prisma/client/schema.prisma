generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InternalUser {
  id           String   @id
  name         String
  email        String   @unique
  role         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreCollection {
  key       String   @id
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
